{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["src/**/*.ts", "tests/**/*.cjs", "prisma.config.ts", "package.json", "tsconfig.json", "biome.json"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "single", "trailingCommas": "none", "semicolons": "always" } },
  "linter": { "enabled": true, "rules": { "preset": "none" } }
}
