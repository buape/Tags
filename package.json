{
  "name": "buape-tags",
  "version": "1.0.0",
  "description": "\ud83c\udff7\ufe0f Tags allows for servers to answer the most frequent questions easier",
  "author": "Codeize",
  "main": "dist/index.js",
  "scripts": {
    "sync": "slash-up sync",
    "sync:dev": "slash-up sync -e development",
    "start": "cd dist && node index.js",
    "build": "prisma generate && tsc",
    "dev": "tsc && slash-up sync && node dist/index.js",
    "db:push": "prisma db push",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "pnpm run build && node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cat-loggr": "^1.2.2",
    "discord.js": "^14.28.0",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "slash-create": "^7.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^26.6.6",
    "prisma": "7.10.1",
    "slash-up": "^1.4.2",
    "ts-node": "^10.9.2",
    "typescript": "~7.0.2"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26 <27"
  },
  "pnpm": {
    "overrides": {
      "slash-up>slash-create": "^7.0.0"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "fastify": "^3 || ^4 || ^5"
      }
    }
  }
}
